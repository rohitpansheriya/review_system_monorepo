// firestore.rules
// Production security rules for Review System.
//
// Authentication model:
//   request.auth.uid          — Firebase Auth user ID
//   request.auth.token.role == 'employee' | 'owner' | 'admin'
//
// Collection structure:
//   /businesses/{bizId}                       — business docs
//   /businesses/{bizId}/branches/{branchId}   — branch subdocs
//   /employees/{empId}                        — employee profiles
//   /commission_records/{recId}               — commission records
//   /notifications/{notifId}                  — notification documents
//   /category_templates/{templateId}          — category templates (read-only for auth users)
//   /scan_logs/{logId}                        — customer scan logs (write-only for clients)
//
// Key design constraints (from 00-architecture-and-schema.md & 06-commission-tracking.md):
//   - Employees may only read businesses where enrolled_by == their uid.
//   - Employees may update standee_status, standee_status_updated_at,
//     and whatsapp_monitored_by on branches — nothing else.
//   - Owners may only access their own business (owner_auth_uid == their uid).
//   - Admins have broad read access; writes go through Cloud Functions or admin credentials.
//   - All activation (pending_payment → active) happens ONLY in the payment
//     webhook Cloud Function. No client-side status promotion is allowed.
//   - draft (pending_payment) businesses are readable by the enrolling employee.
//   - Commission records: Employee can CREATE a cash pending record for their own enrollment
//     and READ their own records — but CANNOT set admin_confirmed, owner_confirmed, or flip
//     status to verified/paid (no self-verification).
//   - Owner can update ONLY owner_confirmed & dispute fields on records for their OWN business.
//   - Commission records cannot be deleted by employees/owners (financial audit trail).

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ───────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function role() {
      return request.auth.token.role;
    }

    function isAdmin() {
      return isSignedIn() && role() == 'admin';
    }

    function isEmployee() {
      return isSignedIn() && role() == 'employee';
    }

    function isOwner() {
      return isSignedIn() && role() == 'owner';
    }

    function isEmployeeOrAdmin() {
      return isSignedIn() && (role() == 'employee' || role() == 'admin');
    }

    // ─── businesses/{bizId} ────────────────────────────────────────────────

    match /businesses/{bizId} {
      // Employee: read only their own enrolled businesses (any status, incl. draft).
      // Admin: read all.
      // Owner: read only their own business (matched by owner_auth_uid).
      allow read: if isAdmin()
        || (isEmployee() && resource.data.enrolled_by == request.auth.uid)
        || (isOwner()    && resource.data.owner_auth_uid == request.auth.uid);

      // CREATE: Only allowed via Cloud Functions (server-side Admin SDK).
      // No client-side create.
      allow create: if false;

      // UPDATE: 
      // - Cloud Functions handles billing/status/dates.
      // - Owner: may update ONLY active_categories on their business, and ONLY when subscription_status == 'active'.
      allow update: if isOwner()
        && resource.data.owner_auth_uid == request.auth.uid
        && resource.data.subscription_status == 'active'
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['active_categories']);

      // DELETE: Not allowed from client side.
      allow delete: if false;

      // ─── businesses/{bizId}/branches/{branchId} ─────────────────────────

      match /branches/{branchId} {
        // Read: same access as parent business.
        allow read: if isAdmin()
          || (isEmployee() && get(/databases/$(database)/documents/businesses/$(bizId)).data.enrolled_by == request.auth.uid)
          || (isOwner()    && get(/databases/$(database)/documents/businesses/$(bizId)).data.owner_auth_uid == request.auth.uid);

        // CREATE: Only via Cloud Functions (enrollment batch write, Admin SDK).
        allow create: if false;

        // UPDATE:
        // - Employees/Admins: standee tracking fields & whatsapp_monitored_by.
        // - Owners: star_routing_config & active_categories.
        allow update: if (
          isEmployeeOrAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'standee_status',
                'standee_status_updated_at',
                'whatsapp_monitored_by',
              ])
          && (
            !('standee_status' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.standee_status in [
                'not_ordered', 'printed', 'shipped', 'delivered'
               ]
          )
        ) || (
          isOwner()
          && get(/databases/$(database)/documents/businesses/$(bizId)).data.owner_auth_uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['star_routing_config', 'active_categories'])
        );

        // DELETE: Not allowed from client side.
        allow delete: if false;
      }
    }

    // ─── employees/{empId} ─────────────────────────────────────────────────

    match /employees/{empId} {
      // Employee: read only their own profile.
      // Admin: read all.
      allow read: if isAdmin()
        || (isEmployee() && request.auth.uid == empId);

      // UPDATE: Employee may update ONLY their own profile, payout, documents, and documents_verified.
      // They may NOT touch name, contact, role, active, total_enrollments, this_month_enrollments.
      // If documents_verified is modified, it can ONLY be set to 'pending' (no self-approval).
      allow update: if isEmployee()
        && request.auth.uid == empId
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'profile',
              'payout',
              'documents',
              'documents_verified',
            ])
        && (
          !('documents_verified' in request.resource.data.diff(resource.data).affectedKeys())
          || request.resource.data.documents_verified == 'pending'
        );

      allow create, delete: if false;
    }

    // ─── commission_records/{recId} ────────────────────────────────────────

    match /commission_records/{recId} {
      // Admin: read all.
      // Employee: read only their own commission records.
      // Owner: read commission records for their own business.
      allow read: if isAdmin()
        || (isEmployee() && resource.data.employee_id == request.auth.uid)
        || (isOwner() && get(/databases/$(database)/documents/businesses/$(resource.data.business_id)).data.owner_auth_uid == request.auth.uid);

      // CREATE: Employee may create a cash payment record (doc 06).
      // The record MUST be created with status = "pending", payment_mode = "cash",
      // and cannot have admin_confirmed=true or owner_confirmed=true or status="verified"/"paid".
      allow create: if isAdmin()
        || (
          isEmployee()
          && request.resource.data.employee_id == request.auth.uid
          && request.resource.data.payment_mode == 'cash'
          && request.resource.data.status == 'pending'
          && request.resource.data.keys().hasAll(['employee_id', 'business_id', 'amount', 'status', 'payment_mode'])
          && (!('admin_confirmed' in request.resource.data) || request.resource.data.admin_confirmed == false)
          && (!('owner_confirmed' in request.resource.data) || request.resource.data.owner_confirmed == null)
          && (!('disputed' in request.resource.data) || request.resource.data.disputed == false)
        );

      // UPDATE:
      // - Admin: full control (can confirm admin_confirmed, mark paid, etc.).
      // - Owner: can set ONLY owner_confirmed / dispute fields on records for their OWN business.
      //   Owner CANNOT change financial audit fields (employee_id, amount, business_id, payment_mode).
      //   Owner CANNOT set admin_confirmed or mark status="paid".
      //   If owner sets status="verified", admin_confirmed MUST already be true.
      // - Employee: CANNOT update (false — prevents self-verification).
      allow update: if isAdmin()
        || (
          isOwner()
          && get(/databases/$(database)/documents/businesses/$(resource.data.business_id)).data.owner_auth_uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'owner_confirmed',
                'owner_confirmed_at',
                'owner_response',
                'disputed',
                'dispute_reason',
                'status',
                'date_verified',
              ])
          && request.resource.data.employee_id == resource.data.employee_id
          && request.resource.data.business_id == resource.data.business_id
          && request.resource.data.amount == resource.data.amount
          && request.resource.data.payment_mode == resource.data.payment_mode
          && (!('admin_confirmed' in request.resource.data) || request.resource.data.admin_confirmed == resource.data.admin_confirmed)
          && request.resource.data.status != 'paid'
          && (
            request.resource.data.status != 'verified'
            || (resource.data.admin_confirmed == true && request.resource.data.owner_confirmed == true)
          )
        );

      // DELETE: Not allowed from client side (financial audit trail).
      allow delete: if false;
    }

    // ─── notifications/{notifId} ───────────────────────────────────────────

    match /notifications/{notifId} {
      // Any authenticated user can read their own notifications.
      allow read: if isSignedIn()
        && (
          resource.data.recipient == request.auth.uid
          || resource.data.recipient == request.auth.token.email
          || (('recipient_uid' in resource.data) && resource.data.recipient_uid == request.auth.uid)
        );

      // Writes are via Cloud Functions (sendNotification service) only.
      allow write: if false;
    }

    // ─── category_templates/{templateId} ──────────────────────────────────

    match /category_templates/{templateId} {
      // Public read (customer review page loads template without auth).
      allow read: if true;

      // Writes are admin-only via console or Cloud Functions.
      allow write: if isAdmin();
    }

    // ─── scan_logs/{logId} ────────────────────────────────────────────────

    match /scan_logs/{logId} {
      // Public scan logging: write-only per scan.
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ─── Catch-all: deny everything else ───────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
