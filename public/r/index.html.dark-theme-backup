<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <meta name="description" content="Share your experience and help others discover this business." />
  <meta name="robots" content="noindex, nofollow" />
  <title>Leave a Review</title>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

  <style>
    /* ─── Design Tokens ─────────────────────────────────────────────── */
    :root {
      --c-bg: #0e0e14;
      --c-surface: #181824;
      --c-surface2: #212132;
      --c-border: rgba(255, 255, 255, 0.08);
      --c-border-active: rgba(124, 108, 252, 0.45);
      --c-text: #f3f3f8;
      --c-text-muted: #8e8ea8;
      --c-accent: #7c6cfc;
      --c-accent-glow: rgba(124, 108, 252, 0.35);
      --c-star-off: #2a2a3e;
      --c-star-on: #ffb800;
      --c-star-glow: rgba(255, 184, 0, 0.45);
      --c-success: #10b981;
      --c-danger: #ef4444;
      --c-whatsapp: #25d366;
      --c-google: #4285f4;
      --radius-sm: 10px;
      --radius-md: 16px;
      --radius-lg: 24px;
      --font: 'Outfit', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      --transition: 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* ─── Reset ──────────────────────────────────────────────────────── */
    *,
    *::before,
    *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html,
    body {
      min-height: 100%;
      background: var(--c-bg);
      color: var(--c-text);
      font-family: var(--font);
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }

    /* ─── Layout ─────────────────────────────────────────────────────── */
    #app {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 0 16px 48px;
    }

    .screen {
      display: none;
      width: 100%;
      max-width: 480px;
      animation: screenFadeIn 0.35s cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    .screen.active {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    @keyframes screenFadeIn {
      from {
        opacity: 0;
        transform: translateY(14px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }

    /* ─── Card ───────────────────────────────────────────────────────── */
    .card {
      width: 100%;
      background: var(--c-surface);
      border: 1px solid var(--c-border);
      border-radius: var(--radius-lg);
      padding: 24px 20px;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.22);
    }

    .thank-you-card {
      width: 100%;
      text-align: center;
      padding: 38px 22px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }

    /* ─── Header band ────────────────────────────────────────────────── */
    .header-band {
      width: 100%;
      max-width: 480px;
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 24px 4px 12px;
    }

    .biz-logo-container {
      position: relative;
      width: 52px;
      height: 52px;
      flex-shrink: 0;
    }

    .biz-logo {
      width: 52px;
      height: 52px;
      border-radius: var(--radius-md);
      object-fit: cover;
      border: 2px solid var(--c-border);
      background: var(--c-surface2);
      flex-shrink: 0;
      transition: opacity 0.25s ease;
    }

    .biz-logo-placeholder {
      width: 52px;
      height: 52px;
      border-radius: var(--radius-md);
      background: linear-gradient(135deg, var(--c-accent), #4f46e5);
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 22px;
      box-shadow: 0 4px 14px var(--c-accent-glow);
      flex-shrink: 0;
      user-select: none;
      transition: opacity 0.25s ease;
    }

    .biz-meta {
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .biz-name {
      font-size: 19px;
      font-weight: 700;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .biz-branch {
      font-size: 13px;
      color: var(--c-text-muted);
      margin-top: 2px;
    }

    /* ─── Language Bar ───────────────────────────────────────────────── */
    .lang-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      max-width: 480px;
      margin-bottom: 8px;
      padding: 6px 14px;
      background: var(--c-surface);
      border: 1px solid var(--c-border);
      border-radius: var(--radius-md);
    }

    .lang-label {
      font-size: 12px;
      color: var(--c-text-muted);
      font-weight: 500;
    }

    .lang-options {
      display: flex;
      gap: 6px;
    }

    .lang-btn {
      background: transparent;
      border: 1px solid var(--c-border);
      color: var(--c-text-muted);
      padding: 3px 10px;
      border-radius: 12px;
      font-size: 12px;
      font-family: var(--font);
      cursor: pointer;
      transition: var(--transition);
    }

    .lang-btn.active {
      background: var(--c-accent);
      color: #fff;
      border-color: var(--c-accent);
      font-weight: 600;
    }

    /* ─── Typography ─────────────────────────────────────────────────── */
    .screen-title {
      font-size: 20px;
      font-weight: 700;
      margin-bottom: 6px;
      color: var(--c-text);
    }

    .screen-sub {
      font-size: 14px;
      color: var(--c-text-muted);
      line-height: 1.5;
    }

    .section-title {
      font-size: 14px;
      font-weight: 600;
      color: var(--c-text);
      margin-bottom: 12px;
      letter-spacing: 0.2px;
    }

    /* ─── Stars Component ────────────────────────────────────────────── */
    .star-grid {
      display: flex;
      justify-content: center;
      gap: 10px;
      margin: 18px 0 8px;
    }

    .star-btn {
      background: none;
      border: none;
      font-size: 44px;
      color: var(--c-star-off);
      cursor: pointer;
      transition: transform 0.22s cubic-bezier(0.34, 1.56, 0.64, 1), color 0.2s ease, text-shadow 0.2s ease;
      line-height: 1;
      user-select: none;
      -webkit-tap-highlight-color: transparent;
      padding: 4px;
    }

    .star-btn:hover {
      transform: scale(1.2);
    }

    .star-btn:active {
      transform: scale(1.32);
    }

    .star-btn.lit {
      color: var(--c-star-on);
      text-shadow: 0 0 18px var(--c-star-glow);
    }

    .rating-badge {
      display: inline-block;
      margin-top: 6px;
      padding: 4px 14px;
      border-radius: 20px;
      font-size: 13px;
      font-weight: 600;
      background: var(--c-surface2);
      color: var(--c-star-on);
      border: 1px solid rgba(255, 184, 0, 0.25);
      animation: badgePop 0.3s cubic-bezier(0.34, 1.56, 0.64, 1) both;
    }

    @keyframes badgePop {
      0% {
        opacity: 0;
        transform: scale(0.85);
      }
      100% {
        opacity: 1;
        transform: scale(1);
      }
    }

    /* ─── Dynamic Rating Container & Transitions ─────────────────────── */
    .dynamic-container {
      display: flex;
      flex-direction: column;
      gap: 16px;
      width: 100%;
    }

    .dynamic-section {
      display: none;
      width: 100%;
      flex-direction: column;
      gap: 16px;
    }

    .dynamic-section.active {
      display: flex;
      animation: dynamicSectionIn 0.38s cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    @keyframes dynamicSectionIn {
      0% {
        opacity: 0;
        transform: translateY(18px) scale(0.985);
      }
      100% {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    /* ─── Category chips ──────────────────────────────────────────────── */
    #chip-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .chip {
      background: var(--c-surface2);
      border: 1px solid var(--c-border);
      color: var(--c-text-muted);
      padding: 9px 15px;
      border-radius: var(--radius-md);
      font-size: 13px;
      font-weight: 500;
      font-family: var(--font);
      cursor: pointer;
      transition: transform 0.18s cubic-bezier(0.34, 1.56, 0.64, 1), background 0.2s ease, border-color 0.2s ease, color 0.2s ease, box-shadow 0.2s ease;
      user-select: none;
      -webkit-tap-highlight-color: transparent;
    }

    .chip:hover {
      border-color: var(--c-accent);
      color: var(--c-text);
      transform: translateY(-1px);
    }

    .chip:active {
      transform: scale(0.95);
    }

    .chip.selected {
      background: var(--c-accent);
      border-color: var(--c-accent);
      color: #fff;
      font-weight: 600;
      box-shadow: 0 0 16px var(--c-accent-glow);
    }

    /* ─── Textarea & Buttons ─────────────────────────────────────────── */
    textarea {
      width: 100%;
      background: var(--c-surface2);
      border: 1px solid var(--c-border);
      border-radius: var(--radius-md);
      color: var(--c-text);
      font-family: var(--font);
      font-size: 14px;
      line-height: 1.6;
      padding: 14px;
      resize: vertical;
      outline: none;
      transition: var(--transition);
    }

    textarea:focus {
      border-color: var(--c-accent);
      box-shadow: 0 0 14px var(--c-accent-glow);
    }

    .btn {
      width: 100%;
      padding: 16px;
      border-radius: var(--radius-md);
      border: none;
      font-family: var(--font);
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.2s ease, box-shadow 0.2s ease;
      user-select: none;
      -webkit-tap-highlight-color: transparent;
    }

    .btn-google {
      background: var(--c-google);
      color: #fff;
      box-shadow: 0 4px 18px rgba(66, 133, 244, 0.35);
    }

    .btn-google:hover {
      opacity: 0.94;
      transform: translateY(-1px);
      box-shadow: 0 6px 22px rgba(66, 133, 244, 0.45);
    }

    .btn-google:active {
      transform: scale(0.98);
    }

    .btn-whatsapp {
      background: var(--c-whatsapp);
      color: #fff;
      box-shadow: 0 4px 18px rgba(37, 211, 102, 0.3);
    }

    .btn-whatsapp:hover {
      opacity: 0.94;
      transform: translateY(-1px);
    }

    .btn-whatsapp:active {
      transform: scale(0.98);
    }

    .btn-outline {
      background: transparent;
      border: 1px solid var(--c-border);
      color: var(--c-text-muted);
      font-weight: 500;
    }

    .btn-outline:hover {
      border-color: rgba(255, 255, 255, 0.25);
      color: var(--c-text);
    }

    .icon {
      width: 20px;
      height: 20px;
      flex-shrink: 0;
    }

    /* ─── Expandable Terms of Service policy box (Doc 07) ─────────────── */
    .tos-card {
      background: var(--c-surface2);
      border: 1px solid var(--c-border);
      border-radius: var(--radius-md);
      padding: 10px 14px;
      cursor: pointer;
      user-select: none;
      transition: border-color var(--transition), background var(--transition);
      -webkit-tap-highlight-color: transparent;
    }

    .tos-card:hover {
      border-color: rgba(255, 255, 255, 0.18);
    }

    .tos-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
    }

    .tos-heading {
      font-size: 11px;
      font-weight: 600;
      color: var(--c-text-muted);
      text-transform: uppercase;
      letter-spacing: 0.6px;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .tos-heading .asterisks {
      color: var(--c-accent);
      font-weight: 700;
      font-size: 13px;
    }

    .tos-chevron {
      font-size: 9px;
      color: var(--c-text-muted);
      transition: transform 0.25s ease;
    }

    .tos-card.expanded .tos-chevron {
      transform: rotate(180deg);
    }

    .tos-body {
      max-height: 0;
      overflow: hidden;
      opacity: 0;
      transition: max-height 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s ease, margin-top 0.25s ease;
    }

    .tos-card.expanded .tos-body {
      max-height: 350px;
      opacity: 1;
      margin-top: 10px;
    }

    .tos-list {
      list-style-type: disc;
      padding-left: 16px;
      display: flex;
      flex-direction: column;
      gap: 5px;
    }

    .tos-list li {
      font-size: 11px;
      color: var(--c-text-muted);
      line-height: 1.45;
    }

    /* ─── Utility ────────────────────────────────────────────────────── */
    .spinner {
      width: 38px;
      height: 38px;
      border: 3px solid var(--c-border);
      border-top-color: var(--c-accent);
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
      margin: 60px auto;
    }

    @keyframes spin {
      to {
        transform: rotate(360deg);
      }
    }

    .big-icon {
      font-size: 54px;
      margin-bottom: 14px;
    }

    .divider {
      width: 100%;
      height: 1px;
      background: var(--c-border);
      margin: 18px 0;
    }
  </style>
</head>

<body>
  <div id="app">
    <!-- Header band (Logo + Business Name) -->
    <div class="header-band" id="header-band" style="display:none;">
      <div class="biz-logo-container">
        <img id="biz-logo" class="biz-logo" src="" alt="Logo" style="display:none;" />
        <div id="biz-logo-placeholder" class="biz-logo-placeholder">B</div>
      </div>
      <div class="biz-meta">
        <div class="biz-name" id="biz-name">Business</div>
        <div class="biz-branch" id="biz-branch">Location</div>
      </div>
    </div>

    <!-- Language selector bar -->
    <div class="lang-bar" id="lang-bar" style="display:none;">
      <span class="lang-label" id="lbl-lang-label">Language:</span>
      <div class="lang-options">
        <button class="lang-btn active" data-lang="en">EN</button>
        <button class="lang-btn" data-lang="hi">हिन्दी</button>
        <button class="lang-btn" data-lang="gu">ગુજરાતી</button>
      </div>
    </div>

    <!-- Screen 0: Loading -->
    <div id="screen-loading" class="screen active">
      <div class="spinner"></div>
    </div>

    <!-- Screen 0B: Error -->
    <div id="screen-error" class="screen" style="display:none;">
      <div class="card thank-you-card">
        <div class="big-icon">⚠️</div>
        <div class="screen-title">Link Invalid</div>
        <p class="screen-sub">This review link is missing parameters or no longer valid.</p>
      </div>
    </div>

    <!-- Screen 0C: Unavailable / Deactivated -->
    <div id="screen-unavailable" class="screen" style="display:none;">
      <div class="card thank-you-card">
        <div class="big-icon">🔒</div>
        <div class="screen-title">Temporarily Unavailable</div>
        <p class="screen-sub">This business page is currently not accepting reviews.</p>
      </div>
    </div>

    <!-- Screen 0D: Already Submitted / Confirmation -->
    <div id="screen-done" class="screen" style="display:none;">
      <div class="card thank-you-card">
        <div class="big-icon">✨</div>
        <div class="screen-title" id="lbl-done-title">Feedback Submitted!</div>
        <p class="screen-sub" id="lbl-done-sub">Thank you! Your feedback has been received and helps us serve you better.</p>
        <div class="divider"></div>
        <div style="font-size:13px; color:var(--c-text-muted);">You may now safely close this window.</div>
      </div>
    </div>

    <!-- Screen 1: Unified Single-Screen Review Interface -->
    <div id="screen-main" class="screen">
      
      <!-- Primary Rating Card (Stars always visible & editable) -->
      <div class="card" style="text-align:center;">
        <div class="screen-title" id="lbl-landing-title">Thank you for visiting!</div>
        <p class="screen-sub" id="lbl-landing-sub">How was your experience today?</p>
        
        <div class="star-grid" id="star-grid">
          <button class="star-btn" data-val="1" aria-label="1 Star">★</button>
          <button class="star-btn" data-val="2" aria-label="2 Stars">★</button>
          <button class="star-btn" data-val="3" aria-label="3 Stars">★</button>
          <button class="star-btn" data-val="4" aria-label="4 Stars">★</button>
          <button class="star-btn" data-val="5" aria-label="5 Stars">★</button>
        </div>

        <div id="rating-badge-container" style="display:none;">
          <span id="rating-badge" class="rating-badge"></span>
        </div>
      </div>

      <!-- Dynamic Section Container (Reveals & changes underneath stars with smooth animation) -->
      <div id="dynamic-content" class="dynamic-container" style="display:none;">

        <!-- Section A: Google Maps Path (High Rating) -->
        <div id="section-high" class="dynamic-section">
          
          <div class="card">
            <div class="section-title" id="lbl-what-loved">What did you love? (select all that apply)</div>
            <div id="chip-grid"></div>
          </div>

          <div class="card" id="review-card">
            <div class="section-title" id="lbl-your-review">Your review (feel free to edit)</div>
            <textarea id="review-text" rows="5" placeholder="Write your review here, or select categories above for quick suggestions…"></textarea>
          </div>

          <!-- Expandable Review Integrity Policy -->
          <div class="card tos-card" id="tos-card" role="button" aria-expanded="false" tabindex="0">
            <div class="tos-header">
              <div class="tos-heading">
                <span class="asterisks">**</span>
                <span id="lbl-tos-heading">Review Integrity Policy</span>
              </div>
              <span class="tos-chevron">▼</span>
            </div>
            <div class="tos-body" id="tos-body">
              <ul class="tos-list">
                <li id="lbl-tos-1">Suggested phrases are provided only as a starting point — they don't replace your own words.</li>
                <li id="lbl-tos-2">You are free to edit the review before posting it.</li>
                <li id="lbl-tos-3">You should only describe your own genuine experience.</li>
                <li id="lbl-tos-4">Fake or false reviews must not be posted.</li>
                <li id="lbl-tos-5">You have complete freedom to give any rating, regardless of the review content.</li>
              </ul>
            </div>
          </div>

          <button class="btn btn-google" id="btn-google-post">
            <svg class="icon" viewBox="0 0 24 24" fill="currentColor">
              <path
                d="M21.35 11.1H12.18V13.83H18.69C18.36 17.64 15.19 19.27 12.19 19.27C8.36 19.27 5 16.25 5 12C5 7.9 8.2 4.73 12.2 4.73C15.29 4.73 17.1 6.7 17.1 6.7L19 4.72C19 4.72 16.56 2 12.1 2C6.42 2 2.03 6.8 2.03 12C2.03 17.05 6.16 22 12.25 22C17.6 22 21.5 18.33 21.5 12.91C21.5 11.76 21.35 11.1 21.35 11.1Z" />
            </svg>
            <span id="lbl-google-post">Copy & Open Google Maps</span>
          </button>
        </div>

        <!-- Section B: Direct Feedback / WhatsApp Path (Low Rating) -->
        <div id="section-low-wa" class="dynamic-section">
          <div class="card">
            <div class="screen-title" id="lbl-wa-title">Sorry to hear that</div>
            <p class="screen-sub" id="lbl-wa-sub">Please tell us what went wrong so we can make it right.</p>
            <textarea id="wa-text" rows="4" placeholder="Describe your experience…" style="margin-top:14px;"></textarea>
            <button class="btn btn-whatsapp" id="btn-wa-send" style="margin-top:14px;">
              <svg class="icon" viewBox="0 0 24 24" fill="currentColor">
                <path
                  d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z" />
                <path
                  d="M12 0C5.373 0 0 5.373 0 12c0 2.127.558 4.122 1.531 5.848L0 24l6.335-1.509A11.932 11.932 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.798 9.798 0 0 1-5.031-1.388l-.361-.214-3.741.981.999-3.647-.236-.374A9.774 9.774 0 0 1 2.182 12c0-5.413 4.405-9.818 9.818-9.818 5.413 0 9.818 4.405 9.818 9.818 0 5.413-4.405 9.818-9.818 9.818z" />
              </svg>
              <span id="lbl-wa-send">Send via WhatsApp</span>
            </button>
            <button class="btn btn-outline" id="btn-low-skip" style="margin-top:10px;">Skip / Submit</button>
          </div>
        </div>

        <!-- Section C: Thank You Only Path -->
        <div id="section-low-thanks" class="dynamic-section">
          <div class="card thank-you-card">
            <div class="big-icon">🙏</div>
            <div class="screen-title" id="lbl-thanks-title">We appreciate your honesty</div>
            <p class="screen-sub" id="lbl-thanks-sub">Thank you for taking the time to share your feedback with us.</p>
            <button class="btn btn-google" id="btn-thanks-submit" style="margin-top:22px; background:var(--c-accent); box-shadow:0 4px 18px var(--c-accent-glow);">
