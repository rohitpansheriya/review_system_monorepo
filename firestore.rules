// firestore.rules
// Production security rules for Review System.
//
// Authentication & Role model:
//   request.auth.uid          — Firebase Auth user ID
//   request.auth.token.role == 'employee' | 'owner' | 'admin'

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ───────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function role() {
      return request.auth.token.role;
    }

    function isAdmin() {
      return isSignedIn() && role() == 'admin';
    }

    function isEmployee() {
      return isSignedIn() && role() == 'employee';
    }

    function isEmployeeActive() {
      return isEmployee()
        && (
          !('status' in get(/databases/$(database)/documents/employees/$(request.auth.uid)).data)
          || get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.status == 'active'
        )
        && (
          !('active' in get(/databases/$(database)/documents/employees/$(request.auth.uid)).data)
          || get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.active == true
        );
    }

    function isOwner() {
      return isSignedIn() && role() == 'owner';
    }

    function isEmployeeOrAdmin() {
      return isAdmin() || isEmployeeActive();
    }

    // ─── businesses/{bizId} ────────────────────────────────────────────────

    match /businesses/{bizId} {
      // READ:
      // - Public customer review page: read business display config (brand_name, logo_url, etc.)
      //   when loading /r/{branchId} (if status is not deleted).
      // - Admin: read all.
      // - Employee: read self-enrolled businesses (only while employee is active).
      // - Owner: read own business (matched by owner_auth_uid).
      allow read: if isAdmin()
        || (isEmployeeActive() && resource.data.enrolled_by == request.auth.uid)
        || (isOwner()          && resource.data.owner_auth_uid == request.auth.uid)
        || (resource.data.subscription_status in ['active', 'grace_period', 'pending_payment']);

      // CREATE: Active Employee or Admin creating a new enrollment draft (pending_payment).
      allow create: if isEmployeeOrAdmin()
        && request.resource.data.subscription_status == 'pending_payment'
        && request.resource.data.enrolled_by == request.auth.uid
        && request.resource.data.brand_name is string
        && request.resource.data.brand_name.size() <= 200;

      // UPDATE:
      // - Admin: full update (subscription overrides, category templates, etc.).
      // - Employee: editable basic fields (brand_name, logo_url, category_type, default_category_template_id, owner_name, owner_email, owner_phone).
      //   Must be active and must be the enroller (enrolled_by == uid).
      //   CANNOT update subscription_status, renewal_date, grace_period_ends, or enrolled_by.
      // - Owner: may update ONLY active_categories on their business, and ONLY when subscription_status == 'active'.
      allow update: if isAdmin()
        || (
          isEmployeeActive()
          && resource.data.enrolled_by == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'brand_name',
                'logo_url',
                'category_type',
                'default_category_template_id',
                'owner_name',
                'owner_email',
                'owner_phone'
              ])
          && (!('brand_name' in request.resource.data) || (request.resource.data.brand_name is string && request.resource.data.brand_name.size() <= 200))
        )
        || (
          isOwner()
          && resource.data.owner_auth_uid == request.auth.uid
          && resource.data.subscription_status == 'active'
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['active_categories'])
        );

      // DELETE: Admin can delete pending_payment drafts or admin operations.
      // Active Employee can delete ONLY pending_payment drafts enrolled by themselves.
      // CANNOT delete active or grace_period businesses.
      allow delete: if isAdmin()
        || (
          isEmployeeActive()
          && resource.data.subscription_status == 'pending_payment'
          && resource.data.enrolled_by == request.auth.uid
        );

      // ─── businesses/{bizId}/branches/{branchId} ─────────────────────────

      match /branches/{branchId} {
        // READ: Public review page loads branch display config; all roles and public can read.
        allow read: if true;

        // CREATE: Active Employee or Admin creating branch subdocs during enrollment.
        allow create: if isEmployeeOrAdmin();

        // UPDATE:
        // - Admin: full update.
        // - Active Employees: editable branch detail fields & standee tracking (for self-enrolled businesses).
        //   CANNOT update subscription_status, payment_mode, stats_summary, qr_code_id, plain_qr_storage_path, or star_routing_config.
        // - Owners: star_routing_config & active_categories.
        // (Public stats_summary updates are handled securely server-side via onScanCreated Cloud Function trigger).
        allow update: if isAdmin()
          || (
            isEmployeeActive()
            && get(/databases/$(database)/documents/businesses/$(bizId)).data.enrolled_by == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly([
                  'branch_name',
                  'address',
                  'whatsapp_number',
                  'whatsapp_monitored_by',
                  'place_id',
                  'google_review_link',
                  'category_override_id',
                  'standee_status',
                  'standee_status_updated_at'
                ])
          )
          || (
            isOwner()
            && get(/databases/$(database)/documents/businesses/$(bizId)).data.owner_auth_uid == request.auth.uid
            && get(/databases/$(database)/documents/businesses/$(bizId)).data.subscription_status == 'active'
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['star_routing_config', 'active_categories'])
          );

        // DELETE: Allowed during draft deletion only.
        allow delete: if isAdmin()
          || (
            isEmployeeActive()
            && get(/databases/$(database)/documents/businesses/$(bizId)).data.subscription_status == 'pending_payment'
            && get(/databases/$(database)/documents/businesses/$(bizId)).data.enrolled_by == request.auth.uid
          );
      }

      // ─── businesses/{bizId}/scans/{scanId} ──────────────────────────────
      // Per-business scan log subcollection. One small doc per customer scan.

      match /scans/{scanId} {
        // CREATE: Public (unauthenticated customer scan from review page).
        // Strictly validated schema with capped string sizes.
        allow create: if request.resource.data.keys().hasAll(['branch_id', 'timestamp'])
          && request.resource.data.keys().hasOnly(['branch_id', 'star_rating', 'timestamp', 'session_token', 'action_taken'])
          && request.resource.data.branch_id is string && request.resource.data.branch_id.size() <= 128
          && (
            !('session_token' in request.resource.data)
            || (request.resource.data.session_token is string && request.resource.data.session_token.size() <= 128)
          )
          && (
            !('star_rating' in request.resource.data)
            || (request.resource.data.star_rating is int && request.resource.data.star_rating >= 1 && request.resource.data.star_rating <= 5)
          )
          && (
            !('action_taken' in request.resource.data)
            || (request.resource.data.action_taken is string && request.resource.data.action_taken.size() <= 64)
          );

        // READ: Admin reads all. Owner reads only their own business's scans.
        allow read: if isAdmin()
          || (isOwner() && get(/databases/$(database)/documents/businesses/$(bizId)).data.owner_auth_uid == request.auth.uid);

        // Immutable — no updates or deletes.
        allow update, delete: if false;
      }
    }

    // ─── employees/{empId} ─────────────────────────────────────────────────

    match /employees/{empId} {
      // Employee: read ONLY their own profile.
      // Admin: read all.
      // Public / Owner: DENIED.
      allow read: if isAdmin()
        || (isEmployee() && request.auth.uid == empId);

      // CREATE: Admin only (for employee account creation).
      allow create: if isAdmin();

      // UPDATE:
      // - Admin: full update (documents_verified, status, role, etc.).
      // - Employee: may update ONLY profile, payout, documents, and set documents_verified to 'pending'.
      //   CANNOT update status, role, active, or self-approve documents_verified to 'verified'.
      allow update: if isAdmin()
        || (
          isEmployeeActive()
          && request.auth.uid == empId
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'profile',
                'payout',
                'documents',
                'documents_verified',
              ])
          && (
            !('documents_verified' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.documents_verified == 'pending'
          )
        );

      allow delete: if isAdmin();
    }

    // ─── category_templates/{templateId} ────────────────────────────────────

    match /category_templates/{templateId} {
      allow read: if true; // Publicly readable for review page & enrollment
      allow create, update, delete: if isAdmin(); // Admin CRUD only
    }

    // ─── commission_records/{recId} (LEGACY — read-only) ────────────────────
    // Old collection kept for historical audit trail. No new writes.
    // Client-side code no longer writes to this collection.

    match /commission_records/{recId} {
      // Read: Admin reads all. Employee reads own. Owner reads own business.
      allow read: if isAdmin()
        || (isEmployee() && resource.data.employee_id == request.auth.uid)
        || (isOwner() && get(/databases/$(database)/documents/businesses/$(resource.data.business_id)).data.owner_auth_uid == request.auth.uid);

      // No new creates, updates, or deletes — legacy collection.
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // ─── employee_commissions/{commId} (NEW — commission ledger) ──────────
    // Tracks employee earnings per business activation.
    // Created ONLY by the onBusinessActivated Cloud Function (admin SDK).
    // NEVER deleted — corrections via voided flag if needed.

    match /employee_commissions/{commId} {
      // Read: Admin reads all. Employee reads only their own commissions.
      allow read: if isAdmin()
        || (isEmployee() && resource.data.employee_id == request.auth.uid);

      // Create: DENIED client-side. Only the onBusinessActivated CF creates these.
      allow create: if false;

      // Update: Admin only — for marking commissions as paid.
      // Employee cannot self-modify commission records.
      allow update: if isAdmin();

      // Delete: DENIED for everyone. Commission records are permanent.
      // Corrections use a 'voided' flag, never deletion.
      allow delete: if false;
    }

    // ─── notifications/{notifId} ───────────────────────────────────────────
    // System notifications generated by Cloud Functions (Admin SDK).
    // Client-side creates are DENIED. Recipients may only update read/dismissed status.

    match /notifications/{notifId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.recipient == request.auth.uid);
      allow create: if false;
      allow update: if isAdmin()
        || (
          isSignedIn()
          && resource.data.recipient == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'dismissed', 'read_at', 'dismissed_at'])
        );
      allow delete: if isAdmin();
    }



    // ─── leads/{leadId} ───────────────────────────────────────────────────
    // Public marketing landing page contact/enquiry lead submissions.
    // Unauthenticated create with strict schema validation; Admin read/delete only.

    match /leads/{leadId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'business_name', 'phone', 'city', 'timestamp'])
        && request.resource.data.keys().hasOnly(['name', 'business_name', 'phone', 'city', 'message', 'source', 'status', 'timestamp', 'created_at'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 100
        && request.resource.data.business_name is string && request.resource.data.business_name.size() >= 2 && request.resource.data.business_name.size() <= 150
        && request.resource.data.phone is string && request.resource.data.phone.size() >= 8 && request.resource.data.phone.size() <= 20
        && request.resource.data.city is string && request.resource.data.city.size() >= 2 && request.resource.data.city.size() <= 100
        && (
          !('status' in request.resource.data)
          || (request.resource.data.status in ['lead', 'new'])
        )
        && (
          !('message' in request.resource.data)
          || (request.resource.data.message is string && request.resource.data.message.size() <= 1000)
        )
        && (
          !('source' in request.resource.data)
          || (request.resource.data.source is string && request.resource.data.source.size() <= 64)
        )
        && (
          !('created_at' in request.resource.data)
          || (request.resource.data.created_at is string && request.resource.data.created_at.size() <= 50)
        );

      allow read, update, delete: if isAdmin();
    }

    // ─── subscription_override_logs/{logId} ──────────────────────────────
    // Admin audit trail for subscription overrides and reverse activations.
    // Immutable once created — corrections are new entries, never edits.
    match /subscription_override_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // ─── counters/{counterId} ─────────────────────────────────────────────
    // Internal atomic counters for sequential business numbering.
    match /counters/{counterId} {
      allow read, write: if isAdmin();
    }

    // ─── processed_payment_events/{eventId} ─────────────────────────────
    // Internal server-side ledger for Razorpay webhook idempotency.
    match /processed_payment_events/{eventId} {
      allow read, write: if isAdmin();
    }

    // ─── orphan_payments/{paymentId} ───────────────────────────────────────
    // Payments captured for non-existent/deleted businesses.
    // Written server-side by Cloud Functions (Admin SDK); Admin read/update only.
    match /orphan_payments/{paymentId} {
      allow read, update: if isAdmin();
      allow create, delete: if false;
    }

    // ─── Default-Deny Fallback ─────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
