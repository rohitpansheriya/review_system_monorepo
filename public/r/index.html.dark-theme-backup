    // ─── Session token & submission guard ─────────────────────────────────────
    function getOrCreateSessionToken(branchId) {
      const key = `session_token_${branchId}`;
      let token = sessionStorage.getItem(key);
      if (!token) {
        token = `${Date.now()}_${Math.random().toString(36).slice(2, 10)}`;
        sessionStorage.setItem(key, token);
      }
      return token;
    }

    function isAlreadySubmitted(branchId) {
      return sessionStorage.getItem(`submitted_${branchId}`) === '1';
    }

    function markSubmitted(branchId) {
      sessionStorage.setItem(`submitted_${branchId}`, '1');
      state.submitted = true;
    }

    // ─── Hash-based pool version resolution ──────────────────────────────────
    function resolvePoolVersion(branch, business) {
      const explicit = (branch && branch.pool_version) || (business && business.pool_version);
      if (explicit && ['v1', 'v2', 'v3'].includes(explicit)) return explicit;

      const seed = (branch && branch.id) || (business && business.id) || 'default';
      let hash = 0;
      for (let i = 0; i < seed.length; i++) {
        hash = ((hash << 5) - hash) + seed.charCodeAt(i);
        hash |= 0;
      }
      const versions = ['v1', 'v2', 'v3'];
      return versions[Math.abs(hash) % versions.length];
    }

    // ─── Language & UI Translation Update ────────────────────────────────────
    function applyLanguage(lang) {
      const activeLang = ENABLE_TRANSLATIONS ? lang : 'en';
      state.lang = activeLang;
      const dict = UI_STRINGS[activeLang] || UI_STRINGS.en;

      $('lbl-lang-label').textContent = dict.langLabel;
      $('lbl-landing-title').textContent = dict.landingTitle;
      $('lbl-landing-sub').textContent = dict.landingSub;
      $('lbl-what-loved').textContent = dict.whatLoved;
