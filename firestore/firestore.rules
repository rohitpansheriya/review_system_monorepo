// firestore/firestore.rules
// Production security rules for Review System.
//
// Authentication & Role model:
//   request.auth.uid          — Firebase Auth user ID
//   request.auth.token.role == 'employee' | 'owner' | 'admin'

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ───────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function role() {
      return request.auth.token.role;
    }

    function isAdmin() {
      return isSignedIn() && role() == 'admin';
    }

    function isEmployee() {
      return isSignedIn() && role() == 'employee';
    }

    function isOwner() {
      return isSignedIn() && role() == 'owner';
    }

    function isEmployeeOrAdmin() {
      return isSignedIn() && (role() == 'employee' || role() == 'admin');
    }

    // ─── businesses/{bizId} ────────────────────────────────────────────────

    match /businesses/{bizId} {
      // READ:
      // - Public customer review page: read business display config (brand_name, logo_url, etc.)
      //   when loading /r/{branchId} (if status is not deleted).
      // - Admin: read all.
      // - Employee: read enrolled or currently managed businesses.
      // - Owner: read own business (matched by owner_auth_uid).
      allow read: if isAdmin()
        || (isEmployee() && (resource.data.enrolled_by == request.auth.uid || resource.data.currently_managed_by == request.auth.uid))
        || (isOwner()    && resource.data.owner_auth_uid == request.auth.uid)
        || (resource.data.subscription_status in ['active', 'grace_period', 'pending_payment']);

      // CREATE: Employee or Admin creating a new enrollment draft (pending_payment).
      allow create: if isEmployeeOrAdmin()
        && request.resource.data.subscription_status == 'pending_payment'
        && request.resource.data.brand_name is string
        && request.resource.data.brand_name.size() <= 200;

      // UPDATE:
      // - Admin: full update (subscription overrides, category templates, management reassignments).
      // - Employee: editable basic fields (brand_name, logo_url, category_type, default_category_template_id, owner_name, owner_email, owner_phone).
      //   CANNOT update subscription_status, renewal_date, grace_period_ends, or currently_managed_by.
      // - Owner: may update ONLY active_categories on their business, and ONLY when subscription_status == 'active'.
      allow update: if isAdmin()
        || (
          isEmployee()
          && resource.data.enrolled_by == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'brand_name',
                'logo_url',
                'category_type',
                'default_category_template_id',
                'owner_name',
                'owner_email',
                'owner_phone'
              ])
          && (!('brand_name' in request.resource.data) || (request.resource.data.brand_name is string && request.resource.data.brand_name.size() <= 200))
        )
        || (
          isOwner()
          && resource.data.owner_auth_uid == request.auth.uid
          && resource.data.subscription_status == 'active'
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['active_categories'])
        );

      // DELETE: Admin can delete pending_payment drafts or admin operations.
      // Employee can delete ONLY pending_payment drafts enrolled by themselves.
      // CANNOT delete active or grace_period businesses.
      allow delete: if isAdmin()
        || (
          isEmployee()
          && resource.data.subscription_status == 'pending_payment'
          && resource.data.enrolled_by == request.auth.uid
        );

      // ─── businesses/{bizId}/branches/{branchId} ─────────────────────────

      match /branches/{branchId} {
        // READ: Public review page loads branch config; panel users read per parent business rules.
        allow read: if isAdmin()
          || (isEmployee() && get(/databases/$(database)/documents/businesses/$(bizId)).data.enrolled_by == request.auth.uid)
          || (isOwner()    && get(/databases/$(database)/documents/businesses/$(bizId)).data.owner_auth_uid == request.auth.uid)
          || true; // Public review page branch display config

        // CREATE: Employee or Admin creating branch subdocs during enrollment.
        allow create: if isEmployeeOrAdmin();

        // UPDATE:
        // - Admin: full update.
        // - Employees: standee tracking fields & whatsapp_monitored_by + editable branch fields.
        // - Owners: star_routing_config & active_categories.
        allow update: if isAdmin()
          || (
            isEmployee()
            && get(/databases/$(database)/documents/businesses/$(bizId)).data.enrolled_by == request.auth.uid
          )
          || (
            isOwner()
            && get(/databases/$(database)/documents/businesses/$(bizId)).data.owner_auth_uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['star_routing_config', 'active_categories'])
          );

        // DELETE: Allowed during draft deletion only.
        allow delete: if isAdmin() || (isEmployee() && get(/databases/$(database)/documents/businesses/$(bizId)).data.subscription_status == 'pending_payment');
      }
    }

    // ─── employees/{empId} ─────────────────────────────────────────────────

    match /employees/{empId} {
      // Employee: read ONLY their own profile.
      // Admin: read all.
      // Public / Owner: DENIED.
      allow read: if isAdmin()
        || (isEmployee() && request.auth.uid == empId);

      // CREATE: Admin only (for employee account creation).
      allow create: if isAdmin();

      // UPDATE:
      // - Admin: full update (documents_verified, status, role, etc.).
      // - Employee: may update ONLY profile, payout, documents, and set documents_verified to 'pending'.
      //   CANNOT update status, role, active, or self-approve documents_verified to 'verified'.
      allow update: if isAdmin()
        || (
          isEmployee()
          && request.auth.uid == empId
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'profile',
                'payout',
                'documents',
                'documents_verified',
              ])
          && (
            !('documents_verified' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.documents_verified == 'pending'
          )
        );

      allow delete: if isAdmin();
    }

    // ─── category_templates/{templateId} ────────────────────────────────────

    match /category_templates/{templateId} {
      allow read: if true; // Publicly readable for review page & enrollment
      allow create, update, delete: if isAdmin(); // Admin CRUD only
    }

    // ─── commission_records/{recId} (LEGACY — read-only) ────────────────────
    // Old collection kept for historical audit trail. No new writes.
    // Client-side code no longer writes to this collection.

    match /commission_records/{recId} {
      // Read: Admin reads all. Employee reads own. Owner reads own business.
      allow read: if isAdmin()
        || (isEmployee() && resource.data.employee_id == request.auth.uid)
        || (isOwner() && get(/databases/$(database)/documents/businesses/$(resource.data.business_id)).data.owner_auth_uid == request.auth.uid);

      // No new creates, updates, or deletes — legacy collection.
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // ─── employee_commissions/{commId} (NEW — commission ledger) ──────────
    // Tracks employee earnings per business activation.
    // Created ONLY by the onBusinessActivated Cloud Function (admin SDK).
    // NEVER deleted — corrections via voided flag if needed.

    match /employee_commissions/{commId} {
      // Read: Admin reads all. Employee reads only their own commissions.
      allow read: if isAdmin()
        || (isEmployee() && resource.data.employee_id == request.auth.uid);

      // Create: DENIED client-side. Only the onBusinessActivated CF creates these.
      allow create: if false;

      // Update: Admin only — for marking commissions as paid.
      // Employee cannot self-modify commission records.
      allow update: if isAdmin();

      // Delete: DENIED for everyone. Commission records are permanent.
      // Corrections use a 'voided' flag, never deletion.
      allow delete: if false;
    }

    // ─── notifications/{notifId} ───────────────────────────────────────────

    match /notifications/{notifId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.recipient == request.auth.uid);
      allow create: if isEmployeeOrAdmin();
      allow update: if isAdmin() || (isSignedIn() && resource.data.recipient == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ─── scan_logs/{logId} ──────────────────────────────────────────────────

    match /scan_logs/{logId} {
      // Public review page writes scan log (strictly validated schema & capped string sizes)
      allow create: if request.resource.data.keys().hasAll(['branch_id', 'business_id', 'timestamp'])
        && request.resource.data.keys().hasOnly(['branch_id', 'business_id', 'star_rating', 'timestamp', 'session_token', 'action_taken', 'rating', 'action'])
        && request.resource.data.branch_id is string && request.resource.data.branch_id.size() <= 128
        && request.resource.data.business_id is string && request.resource.data.business_id.size() <= 128
        && (
          !('session_token' in request.resource.data)
          || (request.resource.data.session_token is string && request.resource.data.session_token.size() <= 128)
        )
        && (
          !('star_rating' in request.resource.data)
          || (request.resource.data.star_rating is int && request.resource.data.star_rating >= 1 && request.resource.data.star_rating <= 5)
        )
        && (
          !('rating' in request.resource.data)
          || (request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5)
        )
        && (
          !('action_taken' in request.resource.data)
          || (request.resource.data.action_taken is string && request.resource.data.action_taken.size() <= 64)
        )
        && (
          !('action' in request.resource.data)
          || (request.resource.data.action is string && request.resource.data.action.size() <= 64)
        );

      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // ─── Default-Deny Fallback ─────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
