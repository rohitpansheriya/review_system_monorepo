rules_version = '2';

// ============================================================
// Review System — Firestore Security Rules
// Role model is defined in docs/00-architecture-and-schema.md
//
// Roles are delivered via Firebase Auth custom claims:
//   request.auth.token.role == "admin"    → Super Admin
//   request.auth.token.role == "employee" → Employee
//   request.auth.token.role == "owner"    → Business Owner
//
// ❌ NEVER trust the client to enforce access — every rule
//    here enforces server-side. Hidden UI elements are NOT
//    a substitute for server rules.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------------------------------------
    // Helper Functions
    // ----------------------------------------------------------

    /// True if the requester is authenticated at all.
    function isSignedIn() {
      return request.auth != null;
    }

    /// True if the requester holds the super-admin role.
    function isAdmin() {
      return isSignedIn() && request.auth.token.role == "admin";
    }

    /// True if the requester holds the employee role.
    function isEmployee() {
      return isSignedIn() && request.auth.token.role == "employee";
    }

    /// True if the requester holds the owner role.
    function isOwner() {
      return isSignedIn() && request.auth.token.role == "owner";
    }

    // ----------------------------------------------------------
    // employees collection
    // Schema: name, contact, role, total_enrollments,
    //         this_month_enrollments, active
    // ----------------------------------------------------------
    match /employees/{employeeId} {
      // Admin: full CRUD
      allow read, write: if isAdmin();

      // An employee may read & update their own document only.
      // They must not change their own role or active status.
      allow read: if isEmployee() && request.auth.uid == employeeId;
      allow update: if isEmployee()
                    && request.auth.uid == employeeId
                    && !("role"   in request.resource.data.diff(resource.data).affectedKeys())
                    && !("active" in request.resource.data.diff(resource.data).affectedKeys());

      // Owners have no access to the employees collection.
    }

    // ----------------------------------------------------------
    // businesses collection
    // Schema: brand_name, logo_url, category_type,
    //         default_category_template_id, enrolled_by,
    //         enrolled_by_original, currently_managed_by,
    //         subscription_status, renewal_date,
    //         grace_period_ends, owner_auth_uid
    // ----------------------------------------------------------
    match /businesses/{businessId} {
      // Customer review page (unauthenticated QR scan): single-doc get only.
      // Allows loading brand_name, logo_url, category_template_id, subscription_status.
      // Does NOT allow list — prevents unauthenticated enumeration of the collection.
      allow get: if true;

      // Admin: full CRUD on all businesses.
      allow read, write: if isAdmin();

      // Employee: create a new business document during enrollment.
      // Enforces all ownership fields point to THIS employee.
      // subscription_status must be "pending_payment" (the new draft state).
      //   "active" is also accepted here for backward compat / admin-assisted flows,
      //   but normal enrollment always writes "pending_payment".
      // owner_auth_uid may be present but must be null (set by doc 02 owner provisioning).
      // grace_period_ends must be absent at create time (added by renewal lifecycle only).
      // created_at must be present (used by the abandoned-draft cleanup job).
      allow create: if isEmployee()
                    && request.resource.data.enrolled_by          == request.auth.uid
                    && request.resource.data.enrolled_by_original == request.auth.uid
                    && request.resource.data.currently_managed_by == request.auth.uid
                    && (request.resource.data.subscription_status == "pending_payment"
                        || request.resource.data.subscription_status == "active")
                    && !("grace_period_ends" in request.resource.data)
                    && !("renewal_date" in request.resource.data
                         && request.resource.data.subscription_status == "pending_payment")
                    && ("created_at" in request.resource.data)
                    && (!("owner_auth_uid" in request.resource.data)
                        || request.resource.data.owner_auth_uid == null);

      // Employee: read businesses they enrolled OR currently manage.
      // Write access limited to update (not create/delete — admin only).
      allow read: if isEmployee()
                  && (resource.data.enrolled_by == request.auth.uid
                      || resource.data.currently_managed_by == request.auth.uid);
      allow update: if isEmployee()
                    && (resource.data.enrolled_by == request.auth.uid
                        || resource.data.currently_managed_by == request.auth.uid)
                    // ── Payment/lifecycle fields — IMMUTABLE by employee ──────────────
                    // Employees MUST NOT flip subscription_status to active, extend
                    // renewal_date, self-assign owner_auth_uid, or change audit trails.
                    // This closes the self-activation fraud path.
                    && !("subscription_status"     in request.resource.data.diff(resource.data).affectedKeys())
                    && !("renewal_date"            in request.resource.data.diff(resource.data).affectedKeys())
                    && !("grace_period_ends"       in request.resource.data.diff(resource.data).affectedKeys())
                    && !("enrolled_by"             in request.resource.data.diff(resource.data).affectedKeys())
                    && !("enrolled_by_original"    in request.resource.data.diff(resource.data).affectedKeys())
                    && !("owner_auth_uid"          in request.resource.data.diff(resource.data).affectedKeys());

      // Employee: DELETE — pending_payment drafts ONLY.
      // After successful payment (status active / grace_period), employee
      // delete is DENIED. Admin is the only principal that can delete active biz.
      allow delete: if isEmployee()
                    && resource.data.enrolled_by == request.auth.uid
                    && resource.data.subscription_status == "pending_payment";

      // Owner: read their own business document (matched by owner_auth_uid).
      allow read: if isOwner() && resource.data.owner_auth_uid == request.auth.uid;
      // Owner may update limited fields only (e.g. brand_name, logo_url via their dashboard).
      allow update: if isOwner()
                    && resource.data.owner_auth_uid == request.auth.uid
                    // Owners must never touch enrollment or subscription fields.
                    && !("enrolled_by"             in request.resource.data.diff(resource.data).affectedKeys())
                    && !("enrolled_by_original"    in request.resource.data.diff(resource.data).affectedKeys())
                    && !("currently_managed_by"    in request.resource.data.diff(resource.data).affectedKeys())
                    && !("subscription_status"     in request.resource.data.diff(resource.data).affectedKeys())
                    && !("renewal_date"            in request.resource.data.diff(resource.data).affectedKeys())
                    && !("grace_period_ends"       in request.resource.data.diff(resource.data).affectedKeys())
                    && !("owner_auth_uid"          in request.resource.data.diff(resource.data).affectedKeys());

      // ----------------------------------------------------------
      // branches (subcollection of businesses)
      // Schema: branch_name, address, whatsapp_number, place_id,
      //         google_review_link, star_routing_config,
      //         category_override_id, qr_code_id, nfc_tag_id,
      //         stats_summary
      // ----------------------------------------------------------
      match /branches/{branchId} {
        // Customer review page (unauthenticated): single-doc get only.
        // Loads whatsapp_number, place_id, star_routing_config, category_override_id.
        allow get: if true;

        // Admin: full CRUD on all branches.
        allow read, write: if isAdmin();

        // Employee: read branches belonging to businesses they manage.
        allow read: if isEmployee()
                    && (get(/databases/$(database)/documents/businesses/$(businessId)).data.enrolled_by == request.auth.uid
                        || get(/databases/$(database)/documents/businesses/$(businessId)).data.currently_managed_by == request.auth.uid);
        // Employee may update branch config (address, routing, etc.) but not stats_summary
        // (those are written only by Cloud Functions).
        allow update: if isEmployee()
                      && (get(/databases/$(database)/documents/businesses/$(businessId)).data.enrolled_by == request.auth.uid
                          || get(/databases/$(database)/documents/businesses/$(businessId)).data.currently_managed_by == request.auth.uid)
                      && !("stats_summary" in request.resource.data.diff(resource.data).affectedKeys());
        // Employee: create a branch.
        // Uses getAfter() (not get()) so this rule works during a batch write
        // that creates both the business doc AND the branch in the same commit.
        // get() would return null (business not written yet) and always deny.
        // getAfter() reads the post-commit state, seeing the business doc being
        // created in the same batch.
        allow create: if isEmployee()
                      && (getAfter(/databases/$(database)/documents/businesses/$(businessId)).data.enrolled_by == request.auth.uid
                          || getAfter(/databases/$(database)/documents/businesses/$(businessId)).data.currently_managed_by == request.auth.uid);

        // Employee: DELETE a branch — only when parent business is a pending_payment draft.
        // Mirrors the business delete rule above: deleteDraftBusiness() deletes
        // branches in the same batch as the business itself.
        allow delete: if isEmployee()
                      && get(/databases/$(database)/documents/businesses/$(businessId)).data.enrolled_by == request.auth.uid
                      && get(/databases/$(database)/documents/businesses/$(businessId)).data.subscription_status == "pending_payment";


        // Owner: read & update their own business's branches.
        allow read: if isOwner()
                    && get(/databases/$(database)/documents/businesses/$(businessId)).data.owner_auth_uid == request.auth.uid;
        allow update: if isOwner()
                      && get(/databases/$(database)/documents/businesses/$(businessId)).data.owner_auth_uid == request.auth.uid
                      // Owners may update routing config, category override, WhatsApp number etc.
                      // They must not tamper with stats_summary (Cloud Function writes only).
                      && !("stats_summary" in request.resource.data.diff(resource.data).affectedKeys());
      }
    }

    // ----------------------------------------------------------
    // category_templates collection
    // Schema: categories: [{ name, phrase_pool }] — English only.
    // These are globally reusable templates managed by admin.
    // ----------------------------------------------------------
    match /category_templates/{templateId} {
      // Admin: full CRUD.
      allow read, write: if isAdmin();

      // Employees may read templates so they can explain categories to owners.
      allow read: if isEmployee();

      // Owners may read templates (to see what category chips will appear for their branch).
      allow read: if isOwner();

      // Customers (unauthenticated) read templates on the review page.
      // The review page is public, so category templates must be publicly readable.
      allow read: if true;

      // No writes from non-admin.
    }

    // ----------------------------------------------------------
    // scan_logs collection
    // Schema: branch_id, star_rating, timestamp, session_token,
    //         action_taken
    // Write-only per scan — dashboards must NEVER query this
    // collection directly on load (read pre-aggregated stats_summary).
    // Scalability rule #1 & #2 from doc 00.
    // ----------------------------------------------------------
    match /scan_logs/{logId} {
      // Admin: full read & write (for auditing, export, investigation).
      allow read, write: if isAdmin();

      // Anyone (including unauthenticated) may CREATE a scan log —
      // the customer review page has no login. Read is denied to
      // non-admins to prevent cross-business data leakage.
      // Cloud Functions handle all aggregation reads.
      allow create: if true;

      // Deny reads and updates to non-admins.
      allow read, update, delete: if isAdmin();
    }

    // ----------------------------------------------------------
    // commission_records collection
    // Schema: employee_id, business_id, amount, payment_mode,
    //         status, date_claimed, date_verified
    // ----------------------------------------------------------
    match /commission_records/{recordId} {
      // Admin: full CRUD.
      allow read, write: if isAdmin();

      // Employee: read their own commission records; create new claims.
      allow read: if isEmployee() && resource.data.employee_id == request.auth.uid;
      allow create: if isEmployee()
                    && request.resource.data.employee_id == request.auth.uid
                    // A newly claimed commission must start in "pending" status.
                    && request.resource.data.status == "pending";
      // Employee must not self-approve or self-verify commissions.
      allow update, delete: if false;

      // Owners have no access to commission records.
    }
  }
}
