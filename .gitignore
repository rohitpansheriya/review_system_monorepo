# =============================================================
# Git — ignore patterns for review_system_monorepo
# Stack: Flutter (Dart) + Node.js (Firebase Functions) + Firebase
# =============================================================

# -------------------------------------------------------
# code-review-graph (local graph cache — never commit)
# -------------------------------------------------------
.code-review-graph/

# -------------------------------------------------------
# Firebase — service account keys & local emulator data
# -------------------------------------------------------
# ⚠️  NEVER commit service account JSON keys.
firebase-adminsdk*.json
*-service-account*.json
serviceAccountKey.json
.firebaserc          # project alias file — contains real project IDs; add manually after setup
firebase.json        # generated by `firebase init` — add manually after setup

# Firebase local emulator data & state
.firebase/
firestore-debug.log
database-debug.log
pubsub-debug.log
ui-debug.log

# -------------------------------------------------------
# Flutter / Dart
# -------------------------------------------------------
# Build outputs
build/
**/build/

# Dart tool cache
.dart_tool/
**/.dart_tool/

# Pub package lock (keep in version control for apps, but ignore for library repos)
# For this monorepo, keep pubspec.lock so builds are reproducible.
# pubspec.lock  ← intentionally NOT ignored

# Generated files
*.g.dart
*.freezed.dart
*.mocks.dart

# IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/settings.json
.vscode/launch.json

# Flutter-specific
**/android/.gradle
**/android/captures/
**/android/gradlew
**/android/gradlew.bat
**/android/local.properties
**/android/**/GeneratedPluginRegistrant.java
**/ios/.symlinks/
**/ios/Flutter/flutter_export_environment.sh
**/ios/Flutter/Generated.xcconfig
**/ios/Runner/GeneratedPluginRegistrant.h
**/ios/Runner/GeneratedPluginRegistrant.m
**/ios/Runner.xcworkspace/
**/macos/Flutter/GeneratedPluginRegistrant.swift
**/macos/Flutter/Flutter-Debug.xcconfig
**/macos/Flutter/Flutter-Release.xcconfig
**/linux/flutter/generated_plugin_registrant.cc
**/linux/flutter/generated_plugin_registrant.h
**/linux/flutter/generated_plugins.cmake
**/windows/flutter/generated_plugin_registrant.cc
**/windows/flutter/generated_plugin_registrant.h
**/windows/flutter/generated_plugins.cmake

# Gradle caches (Android)
**/.gradle
**/gradle-wrapper.jar

# Flutter coverage
coverage/

# -------------------------------------------------------
# Node.js (Firebase Cloud Functions)
# -------------------------------------------------------
node_modules/
**/node_modules/

# npm & yarn lock files (keep package-lock.json, .npmrc may have tokens)
.npmrc
.yarnrc
yarn-error.log
npm-debug.log*

# Compiled TypeScript output
functions/lib/
functions/dist/

# -------------------------------------------------------
# Environment & secrets — NEVER commit these
# -------------------------------------------------------
.env
.env.*
*.env
!.env.example
secrets/
**/secrets/

# API keys / config files that may contain real values
google-services.json        # Android Firebase config — add per-environment after setup
GoogleService-Info.plist    # iOS Firebase config — add per-environment after setup

# -------------------------------------------------------
# macOS
# -------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Icon?

# -------------------------------------------------------
# IDE & editor misc
# -------------------------------------------------------
*.swp
*.swo
*~
*.orig
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
Thumbs.db

# -------------------------------------------------------
# Testing / coverage artifacts
# -------------------------------------------------------
coverage/
lcov.info
*.lcov

# -------------------------------------------------------
# Logs
# -------------------------------------------------------
*.log
logs/
