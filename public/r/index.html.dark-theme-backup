      $('review-text').placeholder = dict.reviewPlaceholder;
      $('lbl-google-post').textContent = dict.googlePost;
      $('lbl-posted-title').textContent = dict.postedTitle;
      $('lbl-posted-sub').textContent = dict.postedSub;
      $('lbl-wa-title').textContent = dict.waTitle;
      $('lbl-wa-sub').textContent = dict.waSub;
      $('wa-text').placeholder = dict.waPlaceholder;
      $('lbl-wa-send').textContent = dict.waSend;
      $('btn-low-skip').textContent = dict.skip;
      $('lbl-thanks-title').textContent = dict.thanksTitle;
      $('lbl-thanks-sub').textContent = dict.thanksSub;
      $('lbl-thanks-btn').textContent = dict.thanksBtn;
      $('lbl-done-title').textContent = dict.doneTitle;
      $('lbl-done-sub').textContent = dict.doneSub;
      $('lbl-tos-heading').textContent = dict.tosHeading;
      $('lbl-tos-1').textContent = dict.tos1;
      $('lbl-tos-2').textContent = dict.tos2;
      $('lbl-tos-3').textContent = dict.tos3;
      $('lbl-tos-4').textContent = dict.tos4;
      $('lbl-tos-5').textContent = dict.tos5;

      document.querySelectorAll('.lang-btn').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.lang === activeLang);
      });

      if (state.starRating > 0) {
        updateRatingBadge(state.starRating);
      }

      if (state.template) {
        buildChips();
        state.selectedCategories.forEach(catIdx => {
          const cat = state.template.categories[catIdx];
          if (cat) {
            state.phraseMap[catIdx] = pickPhraseForCategory(cat);
          }
        });
        rebuildReviewText();
      }
    }

    document.querySelectorAll('.lang-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        if (ENABLE_TRANSLATIONS) {
          applyLanguage(btn.dataset.lang);
        }
      });
    });

    // ─── Phrase Pool Resolution per Category / Lang / Version ─────────────────
    function getCategoryPhrasePool(cat) {
      const lang = ENABLE_TRANSLATIONS ? state.lang : 'en';
      const ver = state.assignedPoolVersion;

      let poolSource = cat;
      if (lang !== 'en' && cat.translations && cat.translations[lang]) {
        poolSource = cat.translations[lang];
      }

      if (poolSource.phrase_pool_versions && poolSource.phrase_pool_versions[ver] && poolSource.phrase_pool_versions[ver].length) {
        return poolSource.phrase_pool_versions[ver];
      }
      if (poolSource.phrase_pool && poolSource.phrase_pool.length) {
        return poolSource.phrase_pool;
      }
      if (cat.phrase_pool_versions && cat.phrase_pool_versions[ver] && cat.phrase_pool_versions[ver].length) {
        return cat.phrase_pool_versions[ver];
      }
      return cat.phrase_pool || [];
    }

    function getCategoryDisplayName(cat) {
      const lang = ENABLE_TRANSLATIONS ? state.lang : 'en';
      if (lang !== 'en' && cat.translations && cat.translations[lang] && cat.translations[lang].name) {
        return cat.translations[lang].name;
      }
      return cat.name;
    }

    function pickPhraseForCategory(cat) {
      const pool = getCategoryPhrasePool(cat);
      if (!pool.length) return '';
      return pool[Math.floor(Math.random() * pool.length)];
    }

    // ─── Interactive Star Rating UI (Single-Screen Reactive) ───────────────────
    function updateStars(rating) {
      document.querySelectorAll('.star-btn').forEach(btn => {
        btn.classList.toggle('lit', parseInt(btn.dataset.val) <= rating);
      });
    }

    function updateRatingBadge(rating) {
      const dict = UI_STRINGS[state.lang] || UI_STRINGS.en;
      const label = dict.ratingLabels ? dict.ratingLabels[rating - 1] : `${rating} Stars`;
      $('rating-badge').textContent = label;
      $('rating-badge-container').style.display = 'block';
    }

    document.querySelectorAll('.star-grid .star-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        if (state.submitted) return;
        const rating = parseInt(btn.dataset.val);
        state.starRating = rating;
        updateStars(rating);
        updateRatingBadge(rating);
        renderDynamicSection(rating);
      });
    });

    function renderDynamicSection(rating) {
      const cfg = (state.branch && state.branch.star_routing_config) || {};
      // Default: 4-5 stars route to Google Maps, 1-3 stars route to WhatsApp
      const route = cfg[String(rating)] || (rating >= 4 ? 'google' : 'whatsapp');

      const dynamicContainer = $('dynamic-content');
      const secHigh = $('section-high');
      const secLowWa = $('section-low-wa');
      const secLowThanks = $('section-low-thanks');

      dynamicContainer.style.display = 'flex';

      // Hide all sub-sections first & remove active class
      [secHigh, secLowWa, secLowThanks].forEach(el => {
        el.classList.remove('active');
        el.style.display = 'none';
      });

      let targetSection;
      if (route === 'google') {
        targetSection = secHigh;
        buildChips();
        rebuildReviewText();
      } else if (route === 'whatsapp') {
        targetSection = secLowWa;
      } else {
        targetSection = secLowThanks;
      }

      if (targetSection) {
        targetSection.style.display = 'flex';
        // Force reflow so the transition animation replays smoothly
        void targetSection.offsetWidth;
        targetSection.classList.add('active');
      }
    }

    // ─── Category chips & Text Assembly ───────────────────────────────────────
    function buildChips() {
      if (!state.template || !state.template.categories) return;
      const grid = $('chip-grid');
      grid.innerHTML = '';

      state.template.categories.forEach((cat, idx) => {
        const btn = document.createElement('button');
        btn.className = 'chip';
        btn.textContent = getCategoryDisplayName(cat);
        if (state.selectedCategories.has(idx)) {
          btn.classList.add('selected');
        }
        btn.addEventListener('click', () => toggleChip(cat, idx, btn));
        grid.appendChild(btn);
      });
    }

    function toggleChip(cat, idx, btn) {
      if (state.selectedCategories.has(idx)) {
        state.selectedCategories.delete(idx);
        delete state.phraseMap[idx];
        btn.classList.remove('selected');
      } else {
        state.selectedCategories.add(idx);
        state.phraseMap[idx] = pickPhraseForCategory(cat);
        btn.classList.add('selected');
      }
      rebuildReviewText();
    }

    function rebuildReviewText() {
      const ta = $('review-text');
      const card = $('review-card');
      card.style.display = 'block';

      if (!state.selectedCategories.size) {
        if (state.wasAutoGenerated) {
          ta.value = '';
          state.wasAutoGenerated = false;
        }
        return;
      }
      const phrases = [];
      state.template.categories.forEach((cat, idx) => {
        if (state.selectedCategories.has(idx) && state.phraseMap[idx]) {
          phrases.push(state.phraseMap[idx]);
        }
      });
      ta.value = phrases.join(' ');
      state.wasAutoGenerated = true;
    }

    $('review-text').addEventListener('input', () => {
      state.wasAutoGenerated = false;
    });

    // ─── Log scan to Firestore ────────────────────────────────────────────────
    async function logScan({ actionTaken }) {
      try {
        await addDoc(collection(db, 'scan_logs'), {
          branch_id: state.branchId,
          business_id: state.businessId,
          star_rating: state.starRating,
          timestamp: serverTimestamp(),
          session_token: state.sessionToken,
          action_taken: actionTaken,
        });
      } catch (e) {
        console.warn('scan_logs write failed', e);
      }
    }

    // ─── WhatsApp button ─────────────────────────────────────────────────────
    $('btn-wa-send').addEventListener('click', async () => {
      const feedback = $('wa-text').value.trim();
      const num = (state.branch && state.branch.whatsapp_number) || '';
      const msg = encodeURIComponent(feedback || 'Feedback from a customer.');
      await logScan({ actionTaken: 'whatsapp' });
      markSubmitted(state.branchId);
      if (num) {
        window.open(`https://wa.me/${num.replace(/^\+/, '')}?text=${msg}`, '_blank', 'noopener');
      }
      showScreen('done');
    });

    $('btn-low-skip').addEventListener('click', async () => {
      const feedback = $('wa-text').value.trim();
      await logScan({ actionTaken: feedback ? 'feedback_submitted' : 'low_skip' });
      markSubmitted(state.branchId);
      showScreen('done');
    });

    $('btn-thanks-submit').addEventListener('click', async () => {
      await logScan({ actionTaken: 'thankyou' });
      markSubmitted(state.branchId);
      showScreen('done');
    });

    // ─── Google Maps / Copy button ────────────────────────────────────────────
    $('btn-google-post').addEventListener('click', async () => {
      const reviewText = $('review-text').value.trim();

      if (reviewText) {
        try {
          await navigator.clipboard.writeText(reviewText);
        } catch {
          const ta = $('review-text');
          ta.select();
          document.execCommand('copy');
        }
      }

      await logScan({ actionTaken: 'google_maps' });
      markSubmitted(state.branchId);

      const rawPlaceId = (state.branch && state.branch.place_id) || '';
      const placeId = rawPlaceId.replace(/\|/g, 'I');
      
      const mobileUrl = `https://search.google.com/local/writereview/mobile?placeid=${placeId}`;
      const desktopUrl = `https://search.google.com/local/writereview?placeid=${placeId}`;
      const isMobile = /Mobi|Android|iPhone|iPad/i.test(navigator.userAgent);
      
      if (placeId) {
        window.open(isMobile ? mobileUrl : desktopUrl, '_blank', 'noopener');
      }

      showScreen('posted');
    });

    // ─── Expandable Terms of Service / Integrity Policy Accordion ────────────
    const tosCard = $('tos-card');
    if (tosCard) {
      tosCard.addEventListener('click', () => {
        const isExpanded = tosCard.classList.toggle('expanded');
        tosCard.setAttribute('aria-expanded', isExpanded ? 'true' : 'false');
      });
      tosCard.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          tosCard.click();
        }
      });
    }

    // ─── Load data on page init ───────────────────────────────────────────────
    async function init() {
      // Format: /r/{businessId}/{branchId} or fallback /r/{branchId}
      const parts = window.location.pathname.split('/').filter(Boolean);
      let businessId = null;
      let branchId = null;

      if (parts.length >= 3) {
        businessId = parts[1];
        branchId = parts[2];
      } else if (parts.length === 2) {
        branchId = parts[1];
      }

      if (!branchId) {
        showScreen('error');
        return;
      }

      state.branchId = branchId;
      state.sessionToken = getOrCreateSessionToken(branchId);

      if (isAlreadySubmitted(branchId)) {
        showScreen('done');
        return;
      }

      await loadData(businessId, branchId);
    }

    async function loadData(businessId, branchId) {
      try {
        let branchSnap, bizSnap;

        if (businessId) {
          [bizSnap, branchSnap] = await Promise.all([
            getDoc(doc(db, 'businesses', businessId)),
            getDoc(doc(db, 'businesses', businessId, 'branches', branchId)),
          ]);
        } else {
          branchSnap = await getDoc(doc(db, 'branches', branchId));
          if (branchSnap.exists()) {
            const bizRef = branchSnap.ref.parent.parent;
            businessId = bizRef.id;
            bizSnap = await getDoc(bizRef);
          }
        }

        if (!branchSnap || !branchSnap.exists() || !bizSnap || !bizSnap.exists()) {
          showScreen('error');
          return;
        }

        state.businessId = businessId;
        state.business = bizSnap.data();
        state.branch = branchSnap.data();

        // Check subscription status
        const status = state.business.subscription_status;
        if (status === 'deleted' || status === 'suspended' || status === 'pending_payment') {
          showScreen('unavailable');
          return;
        }

        state.assignedPoolVersion = resolvePoolVersion(state.branch, state.business);

        // Load category template from Firestore
        const templateId = state.branch.category_override_id
          || state.business.default_category_template_id
          || 'ice_cream_v1';
        
        let tplSnap = await getDoc(doc(db, 'category_templates', templateId));
        if (!tplSnap.exists()) {
          tplSnap = await getDoc(doc(db, 'category_templates', 'ice_cream_v1'));
        }
        if (!tplSnap.exists()) {
          const allTpls = await getDocs(collection(db, 'category_templates'));
          if (!allTpls.empty) {
            tplSnap = allTpls.docs[0];
          }
        }

        state.template = tplSnap.exists() ? tplSnap.data() : null;

        // Populate header
        const brandName = state.business.brand_name || 'Business';
        $('biz-name').textContent = brandName;
        $('biz-branch').textContent = state.branch.branch_name || '';

        const initial = brandName.trim().charAt(0).toUpperCase() || 'B';
        const placeholderEl = $('biz-logo-placeholder');
        const imgEl = $('biz-logo');
        placeholderEl.textContent = initial;

        const logoUrl = state.business.logo_url;
        if (logoUrl && typeof logoUrl === 'string' && logoUrl.trim().length > 0) {
          const showImg = () => {
            imgEl.style.display = 'block';
            placeholderEl.style.display = 'none';
          };
          const showFallback = () => {
            imgEl.style.display = 'none';
            placeholderEl.style.display = 'flex';
          };

          imgEl.onload = showImg;
          imgEl.onerror = showFallback;
          imgEl.src = logoUrl;

          // Check if already cached/completed by browser
          if (imgEl.complete && imgEl.naturalWidth > 0) {
            showImg();
          }
        } else {
          imgEl.style.display = 'none';
          placeholderEl.style.display = 'flex';
        }

        applyLanguage('en');
        showScreen('main');

      } catch (err) {
        console.error('Load error:', err);
        showScreen('error');
      }
    }

    init();
  </script>
</body>

</html>