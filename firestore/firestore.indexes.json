{
  "indexes": [
    // -------------------------------------------------------
    // businesses collection
    // -------------------------------------------------------

    // List businesses enrolled by a specific employee, ordered by subscription status.
    {
      "collectionGroup": "businesses",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "enrolled_by", "order": "ASCENDING" },
        { "fieldPath": "subscription_status", "order": "ASCENDING" }
      ]
    },

    // Employee dashboard — paginated + date-windowed
    {
      "collectionGroup": "businesses",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "enrolled_by", "order": "ASCENDING" },
        { "fieldPath": "subscription_status", "order": "ASCENDING" },
        { "fieldPath": "created_at", "order": "DESCENDING" }
      ]
    },
    {
      "collectionGroup": "businesses",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "enrolled_by", "order": "ASCENDING" },
        { "fieldPath": "created_at", "order": "DESCENDING" }
      ]
    },
    // List businesses currently managed by an employee, newest-first.
    {
      "collectionGroup": "businesses",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "currently_managed_by", "order": "ASCENDING" },
        { "fieldPath": "renewal_date", "order": "ASCENDING" }
      ]
    },
    // Admin: filter by subscription_status and order by renewal_date (expiry dashboard).
    {
      "collectionGroup": "businesses",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "subscription_status", "order": "ASCENDING" },
        { "fieldPath": "renewal_date", "order": "ASCENDING" }
      ]
    },
    // renewalLifecycle Pass 2: grace_period businesses whose grace_period_ends has passed.
    {
      "collectionGroup": "businesses",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "subscription_status", "order": "ASCENDING" },
        { "fieldPath": "grace_period_ends", "order": "ASCENDING" }
      ]
    },
    // cleanupAbandonedDrafts: pending_payment businesses ordered by created_at
    {
      "collectionGroup": "businesses",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "subscription_status", "order": "ASCENDING" },
        { "fieldPath": "created_at", "order": "ASCENDING" }
      ]
    },
    // Admin overview: filter by status + newest first (GROUP F)
    {
      "collectionGroup": "businesses",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "subscription_status", "order": "ASCENDING" },
        { "fieldPath": "created_at", "order": "DESCENDING" }
      ]
    },
    // Admin: filter by category_type to group businesses by industry.
    {
      "collectionGroup": "businesses",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "category_type", "order": "ASCENDING" },
        { "fieldPath": "subscription_status", "order": "ASCENDING" }
      ]
    },

    // -------------------------------------------------------
    // employees collection
    // -------------------------------------------------------

    // List active employees ordered by this_month_enrollments (leaderboard).
    {
      "collectionGroup": "employees",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "active", "order": "ASCENDING" },
        { "fieldPath": "this_month_enrollments", "order": "DESCENDING" }
      ]
    },
    // List employees by role.
    {
      "collectionGroup": "employees",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "role", "order": "ASCENDING" },
        { "fieldPath": "active", "order": "ASCENDING" }
      ]
    },

    // -------------------------------------------------------
    // scan_logs collection (LEGACY — kept for historical data)
    // -------------------------------------------------------

    // Aggregate: filter logs by branch_id and timestamp range.
    {
      "collectionGroup": "scan_logs",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "branch_id", "order": "ASCENDING" },
        { "fieldPath": "timestamp", "order": "ASCENDING" }
      ]
    },
    // Aggregate: filter by branch_id and star_rating.
    {
      "collectionGroup": "scan_logs",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "branch_id", "order": "ASCENDING" },
        { "fieldPath": "star_rating", "order": "ASCENDING" },
        { "fieldPath": "timestamp", "order": "ASCENDING" }
      ]
    },
    // Aggregate: filter by action_taken + timestamp.
    {
      "collectionGroup": "scan_logs",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "action_taken", "order": "ASCENDING" },
        { "fieldPath": "timestamp", "order": "ASCENDING" }
      ]
    },

    // -------------------------------------------------------
    // scans subcollection (NEW — per-business scan logs)
    // -------------------------------------------------------

    // Recent scans for a specific branch, newest first.
    {
      "collectionGroup": "scans",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "branch_id", "order": "ASCENDING" },
        { "fieldPath": "timestamp", "order": "DESCENDING" }
      ]
    },
    // All recent scans for a business, newest first (paginated).
    // Single-field timestamp index is auto-created by Firestore.

    // -------------------------------------------------------
    // commission_records collection (LEGACY — kept for old data)
    // -------------------------------------------------------

    // Employee view: their own pending commissions.
    {
      "collectionGroup": "commission_records",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "employee_id", "order": "ASCENDING" },
        { "fieldPath": "status", "order": "ASCENDING" }
      ]
    },
    // Employee view: their own commissions ordered by claim date.
    {
      "collectionGroup": "commission_records",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "employee_id", "order": "ASCENDING" },
        { "fieldPath": "date_claimed", "order": "DESCENDING" }
      ]
    },
    // Admin view: filter by status, then by date_claimed.
    {
      "collectionGroup": "commission_records",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "date_claimed", "order": "ASCENDING" }
      ]
    },
    // Admin view: all commissions for a given business.
    {
      "collectionGroup": "commission_records",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "business_id", "order": "ASCENDING" },
        { "fieldPath": "date_claimed", "order": "DESCENDING" }
      ]
    },

    // -------------------------------------------------------
    // employee_commissions collection (NEW — commission ledger)
    // -------------------------------------------------------

    // Admin payout view: pending commissions for a specific employee + month.
    {
      "collectionGroup": "employee_commissions",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "employee_id", "order": "ASCENDING" },
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "activation_month", "order": "DESCENDING" }
      ]
    },
    // Employee view: their own commissions by month.
    {
      "collectionGroup": "employee_commissions",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "employee_id", "order": "ASCENDING" },
        { "fieldPath": "activation_month", "order": "DESCENDING" }
      ]
    },
    // Admin view: all pending commissions across all employees.
    {
      "collectionGroup": "employee_commissions",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "activation_month", "order": "DESCENDING" }
      ]
    },
    // Admin view: all commissions for a specific employee (no status filter).
    {
      "collectionGroup": "employee_commissions",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "employee_id", "order": "ASCENDING" },
        { "fieldPath": "created_at", "order": "DESCENDING" }
      ]
    },

    // -------------------------------------------------------
    // businesses collection — pending cash payment view
    // -------------------------------------------------------

    // Admin view: cash businesses awaiting payment confirmation.
    {
      "collectionGroup": "businesses",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "payment_mode", "order": "ASCENDING" },
        { "fieldPath": "subscription_status", "order": "ASCENDING" },
        { "fieldPath": "created_at", "order": "DESCENDING" }
      ]
    },

    // Owner dashboard: commission records for a business filtered by payment_mode (LEGACY)
    {
      "collectionGroup": "commission_records",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "business_id", "order": "ASCENDING" },
        { "fieldPath": "payment_mode", "order": "ASCENDING" }
      ]
    },

    // -------------------------------------------------------
    // notifications collection
    // -------------------------------------------------------

    {
      "collectionGroup": "notifications",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "business_id", "order": "ASCENDING" },
        { "fieldPath": "type", "order": "ASCENDING" },
        { "fieldPath": "sent_at", "order": "ASCENDING" }
      ]
    },
    {
      "collectionGroup": "notifications",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "recipient", "order": "ASCENDING" },
        { "fieldPath": "read", "order": "ASCENDING" },
        { "fieldPath": "sent_at", "order": "DESCENDING" }
      ]
    },
    // Owner dashboard: notifications filtered by recipient + unread
    {
      "collectionGroup": "notifications",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "recipient", "order": "ASCENDING" },
        { "fieldPath": "read", "order": "ASCENDING" }
      ]
    }
  ],
  "fieldOverrides": [
    {
      "collectionGroup": "branches",
      "fieldPath": "place_id",
      "indexes": [
        { "order": "ASCENDING", "queryScope": "COLLECTION" },
        { "order": "ASCENDING", "queryScope": "COLLECTION_GROUP" }
      ]
    }
  ]
}
